<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.yemen.portssecurity">

    <!-- الأذونات السيادية والأمنية للتطبيق -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- قراءة وكتابة الملفات (Excel, PDF, المرفقات والنسخ الاحتياطي) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_DOCUMENTS" tools:ignore="SelectedPhotoAccess" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <!-- الموقع الجغرافي لتحديد منفذ الضبط والتحقق الميداني -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- أذونات النظام والإشعارات والمهام الخلفية -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- دعم وتوافقية جميع الشاشات (الهواتف والتابلت 7 و10 بوصة والأجهزة القابلة للطي) -->
    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true"
        android:anyDensity="true"
        android:resizeable="true" />

    <application
        android:name=".PortsSecurityApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_yemen_eagle"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_yemen_eagle"
        android:supportsRtl="true"
        android:theme="@style/Theme.PortsSecurity"
        android:requestLegacyExternalStorage="true"
        tools:targetApi="33">

        <!-- موفر الملفات لمشاركة وطباعة تقارير PDF وتصاريح التنقل وكشوفات Excel -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ======================================================== -->
        <!-- شاشات الدخول والمصادقة السيادية                             -->
        <!-- ======================================================== -->

        <!-- شاشة البداية والتحميل والتحقق من التشفير -->
        <activity
            android:name=".presentation.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.PortsSecurity.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentation.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.auth.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".presentation.auth.LoginActivity" />

        <activity
            android:name=".presentation.auth.ChangePasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ======================================================== -->
        <!-- الشاشة الرئيسية ولوحة القيادة                               -->
        <!-- ======================================================== -->

        <activity
            android:name=".presentation.main.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- ======================================================== -->
        <!-- الوحدات السيادية الـ 14                                    -->
        <!-- ======================================================== -->

        <!-- الوحدة 1: إدارة المسافرين -->
        <activity
            android:name=".presentation.passengers.PassengersListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_passengers_list" />

        <!-- الوحدة 2: محاضر الضبط والجوازات المحتجزة واستيراد Excel -->
        <activity
            android:name=".presentation.seizures.SeizuresListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_seizures_list" />

        <activity
            android:name=".presentation.seizures.ImportExcelActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_import_excel" />

        <activity
            android:name=".presentation.seizures.ImportPreviewActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_import_preview" />

        <!-- الوحدة 3: المهاجرون غير الشرعيين -->
        <activity
            android:name=".presentation.migrants.MigrantsListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_migrants_list" />

        <!-- الوحدة 4: المنافذ السيادية الـ 13 -->
        <activity
            android:name=".presentation.ports.PortsListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_ports_list" />

        <!-- الوحدة 5: اللاجئون وتصاريح اللجوء المؤقتة -->
        <activity
            android:name=".presentation.refugees.RefugeesListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_refugees_list" />

        <!-- الوحدة 6: الوافدون الأجانب -->
        <activity
            android:name=".presentation.foreigners.ForeignersListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_foreigners_list" />

        <!-- الوحدة 7: تصاريح التنقل والتحرك الداخلي -->
        <activity
            android:name=".presentation.movement.MovementPermitsListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_movement_permits" />

        <!-- الوحدة 8: التأشيرات والإقامات وكتالوج الـ 15 خدمة -->
        <activity
            android:name=".presentation.visas.VisasListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_visas_list" />

        <!-- الوحدة 11: الرقابة على شركات الحج والصرافة والتوظيف -->
        <activity
            android:name=".presentation.hajj.HajjCompaniesListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_hajj_companies" />

        <!-- الوحدة 12: المكاتبات والمراسلات والبرقيات الرسمية -->
        <activity
            android:name=".presentation.correspondence.MemorandaListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_memoranda_list" />

        <!-- الوحدة 13: التقارير ولوحات المتابعة وتتبع SLA -->
        <activity
            android:name=".presentation.reports.DashboardActivity"
            android:exported="false"
            android:label="@string/title_dashboard" />

        <activity
            android:name=".presentation.reports.ReportsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_reports" />

        <activity
            android:name=".presentation.reports.OfficialPdfReportsActivity"
            android:exported="false"
            android:label="وحدة توليد التقارير الرسمية (PDF iText 7)" />

        <activity
            android:name=".presentation.reports.SLADashboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_sla_dashboard" />

        <!-- إدارة النظام والمستخدمين والنسخ الاحتياطي والأدوار -->
        <activity
            android:name=".presentation.admin.AuditLogActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_audit_log" />

        <activity
            android:name=".presentation.admin.UsersManagementActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_users_management" />

        <activity
            android:name=".presentation.admin.RolesPermissionsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="مصفوفة الأدوار والصلاحيات (RBAC)" />

        <activity
            android:name=".presentation.admin.BackupRestoreActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_backup_restore" />

        <activity
            android:name=".presentation.admin.SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/title_settings" />

        <!-- ======================================================== -->
        <!-- الوحدة 14: وحدة المطور وتخصيص المنظومة (Super Admin)         -->
        <!-- ======================================================== -->
        <activity
            android:name=".presentation.developer.DeveloperModuleActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:label="وحدة المطور (تخصيص المنظومة)" />

    </application>

</manifest>
