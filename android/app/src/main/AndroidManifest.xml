            android:exported="false"
            android:label="@string/title_yemeni_visas" />

        <!-- ======================================================== -->
        <!-- الوحدة 9: الجنسية والزواج                                -->
        <!-- ======================================================== -->

        <activity
            android:name=".presentation.nationality.MarriageRequestActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.nationality.NationalityRequestActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.nationality.NationalityByDecreeActivity"
            android:exported="false" />

        <!-- ======================================================== -->
        <!-- الوحدة 10: وثائق السفر                                   -->
        <!-- ======================================================== -->

        <activity
            android:name=".presentation.traveldocs.TravelDocumentsActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.traveldocs.PalestinianDocsActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.traveldocs.YemeniChildrenPassportsActivity"
            android:exported="false" />

        <!-- ======================================================== -->
        <!-- الوحدة 11: شركات الحج والعمرة                            -->
        <!-- ======================================================== -->

        <activity
            android:name=".presentation.hajj.HajjCompaniesListActivity"
            android:exported="false"
            android:label="@string/title_hajj_companies" />

        <activity
            android:name=".presentation.hajj.CompanySecurityCheckActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.hajj.CompanySuspensionActivity"
            android:exported="false" />

        <!-- ======================================================== -->
        <!-- الوحدة 12: المذكرات والبرقيات الرسمية (نظام القوالب التلقائي) -->
        <!-- ======================================================== -->

        <activity
            android:name=".presentation.correspondence.MemorandaListActivity"
            android:exported="false"
            android:label="@string/title_memoranda_list" />

        <activity
            android:name=".presentation.correspondence.MemorandumEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.correspondence.MemorandumViewActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.correspondence.TelegramActivity"
            android:exported="false"
            android:label="@string/title_telegram" />

        <!-- ======================================================== -->
        <!-- الوحدة 13: التقارير والإحصاءات وسجل العمليات             -->
        <!-- ======================================================== -->

        <activity
            android:name=".presentation.reports.DashboardActivity"
            android:exported="false"
            android:label="@string/title_dashboard" />

        <activity
            android:name=".presentation.reports.ReportsActivity"
            android:exported="false"
            android:label="@string/title_reports" />

        <activity
            android:name=".presentation.reports.AuditLogActivity"
            android:exported="false"
            android:label="@string/title_audit_log" />

        <activity
            android:name=".presentation.reports.SLADashboardActivity"
            android:exported="false"
            android:label="@string/title_sla_dashboard" />

        <!-- إدارة النظام والمستخدمين والنسخ الاحتياطي -->
        <activity
            android:name=".presentation.admin.UsersManagementActivity"
            android:exported="false"
            android:label="@string/title_users_management" />

        <activity
            android:name=".presentation.admin.RolesPermissionsActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.admin.BackupRestoreActivity"
            android:exported="false"
            android:label="@string/title_backup_restore" />

        <activity
            android:name=".presentation.admin.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />

    </application>

</manifest>
