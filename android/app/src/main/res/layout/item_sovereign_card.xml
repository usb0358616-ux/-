<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:strokeColor="@color/surface_card_stroke"
    app:strokeWidth="1dp"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCardCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="#REC-001"
                android:textColor="@color/primary_navy"
                android:textSize="@dimen/text_body" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvCardBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ic_yemen_eagle"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="نشط"
                android:textColor="@color/status_success"
                android:textSize="@dimen/text_caption"
                android:fontFamily="sans-serif-bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-bold"
            android:text="عنوان السجل أو المعاملة السيادية"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_subtitle" />

        <TextView
            android:id="@+id/tvCardSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="الجهة: الإدارة العامة للجوازات | المنفذ: الوديعة"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/divider_color" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCardDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="التاريخ: 2026-10-22"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/tvCardAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="عرض التفاصيل ←"
                android:textColor="@color/primary_navy"
                android:textSize="@dimen/text_caption"
                android:fontFamily="sans-serif-bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
